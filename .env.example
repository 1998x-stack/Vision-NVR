# Copy to .env and edit (trusted local shell configuration)
NVR_CAMERA=/dev/video0
NVR_PORT=7866
NVR_DATA_DIR=$HOME/.local/share/vision-nvr
# NVR_REQUIRE_MOUNT=/mnt/recordings
NVR_DEMO=0
NVR_FPS=8
NVR_WIDTH=640
NVR_HEIGHT=360
# NVR_PYTHON=/absolute/path/to/python
# NVR_CONDA_ENV=vision-nvr

# Exact Host allowlist, WITHOUT scheme/port (anti DNS-rebinding)
# Remote SSH -L tunnels usually use localhost and need no change.
NVR_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
